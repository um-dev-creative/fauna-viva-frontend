{
  "name": "fauna-viva-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:bff": "set -a; [ -f .env ] && . ./.env; set +a; node server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "concurrently \"pnpm run watch\" \"pnpm run start:bff\"",
    "test": "ng test",
    "test:headless": "ng test --no-watch --browsers=ChromeHeadlessNoSandbox",
    "test:bff": "node --test server/test/*.test.js",
    "test:coverage": "ng test --no-watch --browsers=ChromeHeadlessNoSandbox --code-coverage && node scripts/check-coverage-files.mjs",
    "test:bff:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 --test-coverage-include='server/**' --test-coverage-exclude='server/test/**' server/test/*.test.js",
    "test:all": "pnpm test:bff:coverage && pnpm test:coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.6",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}

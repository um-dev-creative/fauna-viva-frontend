# BFF (server.js)
PORT=7006
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
FAUNA_VIVA_API_URL=http://localhost:8130
# Login goes through backbone-rest; the Fauna Viva application must be registered there (task F0-01)
BACKBONE_BASE_URL=https://localhost:8443
BACKBONE_APPLICATION_ID=
# This front end's application client in backbone-rest (managed client, M2M). Required in production (the BFF exits with
# code 78 without it); may be left empty in development if backbone does not require a client for the application.
# Never commit the secret.
BACKBONE_CLIENT_ID=
BACKBONE_CLIENT_SECRET=
# BACKBONE_CLIENT_SCOPES=session:manage
# Dev only: accept backbone's internal-CA certificate
BACKBONE_TLS_INSECURE=false
# true behind HTTPS
COOKIE_SECURE=false
# TLS: set both and the BFF serves HTTPS (always the case behind nginx / in docker compose; plain HTTP only for local dev)
# SSL_CERT_PATH=
# SSL_KEY_PATH=
# Proxies in front of the BFF whose X-Forwarded-For is trusted for the client IP: 1 behind nginx, or their addresses
# ("loopback, 172.16.0.0/12"). Leave empty when browsers reach the BFF directly. Never "true".
# TRUST_PROXY=1
# Requests per client IP per 15 minutes on /api
# RATE_LIMIT_MAX=1200
# Login attempts per client IP per 15 minutes
# LOGIN_RATE_LIMIT_MAX=10
# W3C trace context towards the API (false = no traceparent); share of new traces marked as sampled
# TRACING_ENABLED=true
# TRACE_SAMPLE_RATE=0.1
